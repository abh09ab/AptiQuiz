  {
    "id": "q11",
    "category": "Quantitative Aptitude",
    "difficulty": "Hard",
    "question": "A and B can do a piece of work in 12 days, B and C in 15 days, and C and A in 20 days. In how many days can A alone finish the work?",
    "options": [
      {
        "id": "a",
        "text": "20 days"
      },
      {
        "id": "b",
        "text": "30 days"
      },
      {
        "id": "c",
        "text": "40 days"
      },
      {
        "id": "d",
        "text": "60 days"
      }
    ],
    "correctOptionId": "b",
    "explanation": "2(A+B+C) work rate = 1/12 + 1/15 + 1/20 = 12/60 = 1/5. So A+B+C = 1/10. A's rate = 1/10 - 1/15 = 1/30. A takes 30 days."
  },
